# Copy to .env and edit. Everything is optional.

# Port on this machine. The TV opens http://<this machine>:<port>
DEPARTUREBOARD_PORT=8080

# Timezone schedules are evaluated in (IANA name, e.g. America/New_York).
TZ=UTC

# Which image to run. `latest` follows every release; a board on a wall should pin one:
# DEPARTUREBOARD_IMAGE=ghcr.io/cmldexter/departureboard:0.1.0
DEPARTUREBOARD_IMAGE=ghcr.io/cmldexter/departureboard:latest

# Bring your own token. Leave blank to have one generated on first boot
# (it is printed once in the logs and kept in the data volume).
DEPARTUREBOARD_API_TOKEN=

# CORS is off. List origins, comma-separated, to let a browser app elsewhere call the API.
DEPARTUREBOARD_CORS_ORIGINS=

# Contributors: build from this checkout instead of pulling the image.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
