# Copy to .env and edit. Everything is optional.

# Port on this machine. The TV opens http://<this machine>:<port>
DEPARTUREBOARD_PORT=8080

# Timezone schedules are evaluated in (IANA name, e.g. America/New_York).
TZ=UTC

# Bring your own token. Leave blank to have one generated on first boot
# (it is printed once in the logs and kept in the data volume).
DEPARTUREBOARD_API_TOKEN=
