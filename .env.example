# Copy to .env and edit. Everything is optional.

# Port on this machine. The TV opens http://<this machine>:<port> (https:// with DEPARTUREBOARD_TLS)
DEPARTUREBOARD_PORT=8080

# Timezone schedules are evaluated in (IANA name, e.g. America/New_York).
TZ=UTC

# Which image to run. `latest` follows every release; a board on a wall should pin one:
# DEPARTUREBOARD_IMAGE=ghcr.io/cmldexter/departureboard:0.1.0
DEPARTUREBOARD_IMAGE=ghcr.io/cmldexter/departureboard:latest

# Bring your own token. Leave blank to have one generated on first boot
# (it is printed once in the logs and kept in the data volume).
DEPARTUREBOARD_API_TOKEN=

# CORS is off. List origins, comma-separated, to let a browser app elsewhere call the API.
DEPARTUREBOARD_CORS_ORIGINS=

# HTTPS is off; the TV opens http://. Set `self-signed` to have the server make its own
# certificate on first boot (kept in the data volume) and serve https:// on the same port, which
# lets the TV's browser take the native wake lock. Browsers warn once; see docs/tv-setup.md.
DEPARTUREBOARD_TLS=

# A name for the board. `dboard.localhost` opens in Chrome and Edge on this machine with no
# setup (and counts as secure, like https://); `board.local` or a name from your router works
# on the LAN where that name resolves. The board shows it on the settings page, pre-fills it on
# the integrate page and puts it in the certificate; it does not make the name resolve.
DEPARTUREBOARD_HOST=

# Names and addresses that certificate is valid for, comma-separated. The container cannot know
# the address the TV types, so put it here (delete /data/tls in the container to regenerate).
DEPARTUREBOARD_TLS_HOSTS=

# Or bring your own certificate and key (PEM, mounted into the container, readable by uid 10001).
# Both or neither.
# DEPARTUREBOARD_TLS_CERT=/certs/board.crt
# DEPARTUREBOARD_TLS_KEY=/certs/board.key

# Contributors: build from this checkout instead of pulling the image.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
